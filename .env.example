# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Database
# For local pnpm development, localhost is usually correct.
# In Docker Compose, DATABASE_URL is overridden to use the postgres service hostname.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_bot?schema=public
POSTGRES_DB=telegram_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Telegram bot
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me-with-long-random-string
TELEGRAM_STARS_PRICE=100
TELEGRAM_INVITE_LINK_EXPIRE_HOURS=24
TELEGRAM_CHANNEL_ID=-1001234567890

# Private channel chat IDs per tier.
# Seed matching TelegramChannel rows in the database with these chat IDs.
TELEGRAM_BASIC_CHANNEL_CHAT_ID=-1001111111111
TELEGRAM_PREMIUM_CHANNEL_CHAT_ID=-1002222222222
TELEGRAM_VIP_CHANNEL_CHAT_ID=-1003333333333

# Tribute
TRIBUTE_WEBHOOK_SECRET=replace-me-with-tribute-webhook-secret

# Internal admin API
ADMIN_API_TOKEN=replace-me-with-admin-api-token

# Boosty RSS reposting
BOOSTY_RSS_URL=https://boosty.example/rss.xml
BOOSTY_POLL_INTERVAL_SECONDS=300
BOOSTY_DEFAULT_TIER=basic
