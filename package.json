{
  "name": "telegram-paid-channel-bot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Production-ready TypeScript Node.js backend for a Telegram paid-channel access bot.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
