generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  telegramUserId BigInt        @unique
  username       String?
  firstName      String
  lastName       String?
  languageCode   String?
  isBot          Boolean       @default(false)
  payments       Payment[]
  accessGrants   AccessGrant[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Payment {
  id                      String        @id @default(cuid())
  userId                  String
  provider                String
  invoicePayload          String        @unique
  currency                String
  amount                  Int
  status                  PaymentStatus @default(PENDING)
  telegramChargeId        String?       @unique
  telegramTransactionId   String?       @unique
  rawUpdate               Json?
  confirmedAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccessGrant {
  id             String            @id @default(cuid())
  userId         String
  invoicePayload String            @unique
  status         AccessGrantStatus @default(PENDING)
  inviteLink     String?
  inviteLinkName String?
  grantedAt      DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum AccessGrantStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}
